# ─── EduAlert - Variables de Entorno (PLANTILLA) ─────────────────────────────
# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
#
# ⚠️  NUNCA subas el archivo .env al repositorio

# ─── API Keys (IA) ───────────────────────────────────────────────────────────
# Usa UNA de las dos según el proveedor que elijas:
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASS=

# ─── Webhooks ────────────────────────────────────────────────────────────────
# WEBHOOK_URL=
