# ─── EduAlert - Variables de Entorno (PLANTILLA) ─────────────────────────────
# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
#
# ⚠️  NUNCA subas el archivo .env al repositorio

# ─── API Keys (IA) ───────────────────────────────────────────────────────────
# Usa UNA de las dos según el proveedor que elijas:
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
# HOST=127.0.0.1   # Por defecto en host (solo Nginx). Usar 0.0.0.0 en Docker.
JWT_SECRET=

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASS=

# ─── Webhooks ────────────────────────────────────────────────────────────────
# WEBHOOK_URL=

# ─── Base de Datos (PostgreSQL) ──────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=
DB_NAME=edualert_db
